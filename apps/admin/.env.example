# Admin dashboard (apps/admin) — copy to .env.local and adjust.
# All values are NEXT_PUBLIC_*: they are inlined into the browser bundle at
# build time, so never put secrets here.
#
# Docker / Cloud Run: because they are baked in at BUILD time, pass them as
# `--build-arg NAME=value` to `docker build -f apps/admin/Dockerfile .` and
# build one image per environment. Setting them as Cloud Run runtime env vars
# does nothing. (.env files are excluded from the Docker build context.)
#
# Runtime-only (set by the image / Cloud Run, not here): PORT (default 8080
# in the image), HOSTNAME=0.0.0.0, NODE_ENV=production.

# Backend base URL (the admin app calls ${NEXT_PUBLIC_API_BASE_URL}/api/v1/admin/*).
# Default: http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Monthly Claude spend (USD) the AI Monitor "Month cost" card measures against.
# Display-only — nothing enforces it. Default: 50
NEXT_PUBLIC_CLAUDE_MONTHLY_BUDGET_USD=50

# Daily Claude call count the AI Monitor "API calls today" card measures against.
# Display-only — the backend rate-limits per IP, not globally. Default: 2000
NEXT_PUBLIC_CLAUDE_DAILY_CALL_LIMIT=2000
