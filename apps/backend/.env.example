# Backend (apps/backend) — copy to apps/backend/.env for local dev.
# In production (Cloud Run) set these as service env vars / Secret Manager
# secrets. NEVER bake them into the image (the root .dockerignore excludes
# every .env file from the build context).
#
# With NODE_ENV=production the backend refuses to start and lists every
# missing/invalid variable (src/config/env.ts).

# --- Required in production ------------------------------------------------

# Hosted Supabase API URL (not localhost), e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Supabase service-role key. Secret: bypasses RLS. Backend only.
SUPABASE_SERVICE_KEY=
# Anthropic API key for receipt scanning (Claude Haiku 4.5). Secret.
ANTHROPIC_API_KEY=
# Comma-separated browser origins allowed by CORS (the deployed admin
# dashboard, Expo web). Native mobile requests send no Origin and are not
# affected. Unset -> localhost dev origins only (fatal in production).
ALLOWED_ORIGINS=

# --- Runtime ---------------------------------------------------------------

# 'production' on Cloud Run (enables the startup checks above and defaults
# RATE_LIMIT_STORE to postgres). 'development' locally; Jest sets 'test'.
NODE_ENV=development
# Port to listen on. Local default 3000; the Docker image sets 8080 and
# Cloud Run injects its own PORT.
PORT=3000
# Express 'trust proxy'. Unset/false locally (X-Forwarded-For ignored).
# Cloud Run: 1 (one hop: Google's front end), so req.ip and the per-IP rate
# limits see the real client. 'true' is rejected (client-spoofable).
TRUST_PROXY=
# Where rate-limit counters live: 'memory' (per-process; default outside
# production) or 'postgres' (public.rate_limit_counters, shared by all
# instances; default in production). Fails OPEN if the DB is unreachable.
RATE_LIMIT_STORE=

# --- Scripts only (npm run verify:*), not needed by the server ------------

# Public anon key, used by scripts/verify-rls.ts to attack the DB as a client.
SUPABASE_ANON_KEY=
