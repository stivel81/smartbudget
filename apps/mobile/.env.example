# Copy to .env.local (git-ignored) and fill in real values.
# EXPO_PUBLIC_* values are inlined into the app bundle at build time, so they
# are PUBLIC — never put secrets here. Restart Metro after changing them.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Address opened by Help & Support -> "Contact support" (mailto:).
# If unset, the button is shown disabled with "Support email not configured".
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
