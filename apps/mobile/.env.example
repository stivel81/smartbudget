# Copy to .env.local (git-ignored) and fill in real values.
# EXPO_PUBLIC_* values are inlined into the app bundle at build time, so they
# are PUBLIC — never put secrets here. Restart Metro after changing them.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend base URL (absolute http(s), no trailing slash needed). In a dev
# build (Metro / `npx expo start`) it defaults to http://localhost:3000 when
# unset, which is what the Simulator and Maestro use. Preview/production EAS
# builds get it from their profile in eas.json and show a startup error screen
# if it is missing or invalid. Android emulator: http://10.0.2.2:3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Address opened by Help & Support -> "Contact support" (mailto:).
# If unset, the button is shown disabled with "Support email not configured".
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
